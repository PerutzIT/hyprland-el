# hyprland-el notifications (system default, /usr/share/hypr-el/mako/config)
font=JetBrains Mono 11
background-color=#11132ae6
text-color=#e6e9f5
border-color=#33ccff
border-size=2
border-radius=14
padding=14
margin=12
width=380
height=160
icons=1
max-icon-size=48
default-timeout=6000
anchor=top-right
outer-margin=50,4,0,0
layer=overlay

[urgency=low]
border-color=#8b5cf6

[urgency=critical]
border-color=#ff5577
default-timeout=0

[mode=do-not-disturb]
invisible=1
