#!/bin/bash
# hypr-el-setup - manage the hyprland-el desktop configuration of the current user
#
#   hypr-el-setup            (re)generate the configuration and reload the session
#   hypr-el-setup --copy     copy the full Hyprland config to ~/.config/hypr/hyprland.lua
#                            for hand editing (it then takes precedence over the settings app
#                            for everything Hyprland itself does)
#   hypr-el-setup --reset    back to defaults: removes the settings and own copies (backups kept)
set -euo pipefail
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STAMP=$(date +%Y%m%d-%H%M%S)
backup() { [ -e "$1" ] && mv -v "$1" "$1.bak-$STAMP"; return 0; }

case "${1:-}" in
  "")      hypr-el-apply ;;
  --copy)  mkdir -p "$CFG/hypr"; backup "$CFG/hypr/hyprland.lua"
           install -m 0644 /etc/xdg/hypr/hyprland.lua "$CFG/hypr/hyprland.lua"
           echo "-> $CFG/hypr/hyprland.lua"; hyprctl reload >/dev/null 2>&1 || true ;;
  --reset) backup "$CFG/hypr-el/settings.json"
           for f in hypr/hyprland.lua hypr/hyprpaper.conf hypr/hypridle.conf hypr/hyprlock.conf \
                    waybar/config waybar/config.jsonc waybar/style.css mako/config; do
               backup "$CFG/$f"
           done
           hypr-el-apply ;;
  -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
esac
