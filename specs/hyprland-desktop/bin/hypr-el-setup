#!/bin/bash
# hypr-el-setup - activate / copy the hyprland-el desktop defaults for the current user
#
#   hypr-el-setup            use the system defaults: moves an *autogenerated*
#                            ~/.config/hypr/hyprland.lua out of the way (backup)
#   hypr-el-setup --copy     copy all defaults to ~/.config for customising
#                            (existing files are backed up, never overwritten silently)
#   hypr-el-setup --theme    apply dark GTK/icon/cursor settings (run at login)
#   hypr-el-setup --welcome  show the welcome notification once per user
set -euo pipefail

SHARE=/usr/share/hypr-el
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-el"
STAMP=$(date +%Y%m%d-%H%M%S)

backup() { [ -e "$1" ] && mv -v "$1" "$1.bak-$STAMP"; return 0; }

reload() {
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl reload >/dev/null 2>&1 || true
        echo "Hyprland reloaded. Log out and back in to restart bar, wallpaper and idle daemon."
    fi
}

case "${1:-}" in
  ""|--activate)
    f="$CFG/hypr/hyprland.lua"
    if [ -f "$f" ] && grep -q 'autogenerated *= *true' "$f"; then
        backup "$f"
        echo "Autogenerated config moved away. Now using /etc/xdg/hypr/hyprland.lua."
    elif [ -f "$f" ]; then
        echo "$f is your own config and was left untouched."
        echo "Run 'hypr-el-setup --copy' to replace it (a backup is kept)."
    else
        echo "Using /etc/xdg/hypr/hyprland.lua (no personal config)."
    fi
    reload
    ;;
  --copy)
    mkdir -p "$CFG/hypr" "$CFG/waybar" "$CFG/mako" "$CFG/kitty"
    for pair in \
        "/etc/xdg/hypr/hyprland.lua:$CFG/hypr/hyprland.lua" \
        "/etc/xdg/hypr/hyprpaper.conf:$CFG/hypr/hyprpaper.conf" \
        "/etc/xdg/hypr/hypridle.conf:$CFG/hypr/hypridle.conf" \
        "/etc/xdg/hypr/hyprlock.conf:$CFG/hypr/hyprlock.conf" \
        "/etc/xdg/hypr/hyprtoolkit.conf:$CFG/hypr/hyprtoolkit.conf" \
        "$SHARE/waybar/config.jsonc:$CFG/waybar/config.jsonc" \
        "$SHARE/waybar/style.css:$CFG/waybar/style.css" \
        "$SHARE/mako/config:$CFG/mako/config" \
        "$SHARE/kitty/kitty.conf:$CFG/kitty/kitty.conf"; do
        src=${pair%%:*}; dst=${pair#*:}
        if [ -e "$dst" ] && cmp -s "$src" "$dst"; then continue; fi
        backup "$dst"
        install -m 0644 "$src" "$dst" && echo "-> $dst"
    done
    reload
    ;;
  --theme)
    command -v gsettings >/dev/null || exit 0
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark'   2>/dev/null || true
    gsettings set org.gnome.desktop.interface gtk-theme    'Adwaita-dark'  2>/dev/null || true
    if [ -d /usr/share/icons/Papirus-Dark ]; then
        gsettings set org.gnome.desktop.interface icon-theme 'Papirus-Dark' 2>/dev/null || true
    fi
    gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita'       2>/dev/null || true
    gsettings set org.gnome.desktop.interface cursor-size  24              2>/dev/null || true
    gsettings set org.gnome.desktop.interface font-name 'Noto Sans 11'     2>/dev/null || true
    gsettings set org.gnome.desktop.interface monospace-font-name 'JetBrains Mono 11' 2>/dev/null || true
    gsettings set org.gnome.desktop.wm.preferences button-layout ':'      2>/dev/null || true
    ;;
  --welcome)
    mkdir -p "$STATE"
    [ -e "$STATE/welcomed" ] && exit 0
    sleep 3
    notify-send -a hypr-el -i input-keyboard -t 20000 "Willkommen bei Hyprland  ·  Welcome" \
"<b>SUPER+F1</b>  alle Tastenkürzel / all shortcuts
<b>SUPER+Space</b>  Apps   <b>SUPER+Return</b>  Terminal
<b>SUPER+1…0</b>  Arbeitsflächen / workspaces
<b>SUPER+L</b>  sperren / lock   <b>SUPER+M</b>  beenden / exit" && touch "$STATE/welcomed"
    ;;
  -h|--help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) echo "unknown option: $1 (see --help)" >&2; exit 2 ;;
esac
