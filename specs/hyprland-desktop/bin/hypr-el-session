#!/bin/bash
# hypr-el-session start|restart – start/restart the desktop components with the
# configuration generated by hypr-el-apply. A user's own config files in
# ~/.config/{hypr,waybar,mako} take precedence over the generated ones.
CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
EL="$CFG/hypr-el"
STATE="${XDG_STATE_HOME:-$HOME/.local/state}/hypr-el"
mkdir -p "$STATE"

pick() { # pick <user file>... -- <args for generated>
    local f
    while [ "$1" != "--" ]; do [ -e "$1" ] && { echo ""; return; }; shift; done
    shift; echo "$*"
}

start_bg() { setsid -f "$@" >/dev/null 2>&1 < /dev/null; }

migrate_v1() {
    # hyprland-desktop 1.x copied its defaults to ~/.config (hypr-el-setup --copy).
    # Those files would now override the new settings; move them aside once.
    [ -e "$STATE/migrated-v2" ] && return
    local moved=()
    for f in hypr/hyprpaper.conf hypr/hypridle.conf hypr/hyprlock.conf hypr/hyprtoolkit.conf \
             waybar/config.jsonc waybar/style.css mako/config kitty/kitty.conf hypr/hyprland.lua; do
        p="$CFG/$f"
        [ -f "$p" ] || continue
        if head -n 12 "$p" | grep -qE 'hyprland-el (default|desktop|notifications|kitty|idle|lock screen|theme)' ; then
            mv "$p" "$p.bak-v1" && moved+=("$f")
        fi
    done
    # autogenerated Hyprland config from the very first start
    if [ -f "$CFG/hypr/hyprland.lua" ] && grep -q 'autogenerated *= *true' "$CFG/hypr/hyprland.lua"; then
        mv "$CFG/hypr/hyprland.lua" "$CFG/hypr/hyprland.lua.bak-autogenerated" && moved+=("hypr/hyprland.lua")
    fi
    touch "$STATE/migrated-v2"
    if [ ${#moved[@]} -gt 0 ]; then
        echo "${moved[*]}" > "$STATE/migrated-files"
        return 10
    fi
}

components() {
    local a
    a=$(pick "$CFG/hypr/hyprpaper.conf" -- -c "$EL/hyprpaper.conf");   start_bg hyprpaper $a
    a=$(pick "$CFG/hypr/hypridle.conf"  -- -c "$EL/hypridle.conf");    start_bg hypridle $a
    a=$(pick "$CFG/waybar/config" "$CFG/waybar/config.jsonc" -- -c "$EL/waybar/config.jsonc" -s "$EL/waybar/style.css")
    start_bg waybar $a
    a=$(pick "$CFG/mako/config" -- --config "$EL/mako.conf");          start_bg mako $a
    if ! grep -qs '"desktop_icons": *false' "$EL/settings.json"; then
        start_bg hypr-el-desktop
    fi
}

case "${1:-start}" in
  start)
    migrate_v1; mig=$?
    hypr-el-apply --files-only
    hyprctl reload >/dev/null 2>&1          # pick up the generated settings.lua
    components
    systemctl --user start hyprpolkitagent >/dev/null 2>&1 || start_bg /usr/libexec/hyprpolkitagent
    hypr-el-apply --desktop-only
    if [ "$mig" = 10 ]; then
        notify-send -a hypr-el -i dialog-information "Hyprland-Desktop aktualisiert" \
          "Alte Konfigurationsdateien wurden gesichert (*.bak-v1). Einstellungen: SUPER+I"
    fi
    if [ ! -e "$STATE/welcomed-v2.1" ]; then
        sleep 2
        notify-send -a hypr-el -i preferences-desktop -t 25000 "Willkommen bei Hyprland" \
"<b>SUPER+I</b>  Einstellungen (Theme, Wallpaper, Tastatur …)
<b>SUPER+Leertaste</b>  Programme   <b>SUPER+F1</b>  alle Tastenkürzel
Fenster: Titelleiste ziehen = verschieben, Rand ziehen = Größe
Knöpfe: ✕ schließen · □ maximieren · – minimieren (zurück über die Taskleiste)
Desktop: Doppelklick öffnet, Rechtsklick zeigt ein Menü" \
          && touch "$STATE/welcomed-v2.1"
    fi
    ;;
  restart)
    pkill -u "$USER" -x hyprpaper; pkill -u "$USER" -x hypridle; pkill -u "$USER" -x waybar; pkill -u "$USER" -x mako
    pkill -u "$USER" -f '^/usr/bin/python3 -I /usr/bin/hypr-el-desktop' 
    sleep 0.4
    components
    ;;
  *) echo "usage: $0 start|restart" >&2; exit 2 ;;
esac
