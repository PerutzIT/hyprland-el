EL10 compatibility for gcc-toolset-15 (libstdc++ 15).
Upstream uses two C++26 library features only available in GCC 16:
 - std::ranges::starts_with   -> guarded fallback with identical semantics
 - std::string::subview(p, n) -> std::string_view{s}.substr(p, n) (identical result)

--- a/src/helpers/MiscFunctions.cpp
+++ b/src/helpers/MiscFunctions.cpp
@@ -474,7 +474,12 @@
     });
 
     return [&](auto&&... prefixes) -> bool {
+#if defined(__cpp_lib_ranges_starts_ends_with)
         return (... || std::ranges::starts_with(str_view, prefixes));
+#else
+        // EL compat: libstdc++ < 16 lacks std::ranges::starts_with
+        return (... || (str.size() >= prefixes.size() && std::ranges::equal(str_view | std::views::take(prefixes.size()), prefixes)));
+#endif
     }("true"sv, "yes"sv, "on"sv);
     // clang-format on
 }
