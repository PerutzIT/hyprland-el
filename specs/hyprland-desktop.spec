Name:           hyprland-desktop
Version:        1.0.0
Release:        3%{?dist}
Summary:        Complete, preconfigured Hyprland desktop for Enterprise Linux
License:        MIT
URL:            https://github.com/PerutzIT/hyprland-el
# Generated from specs/hyprland-desktop/ by .copr/Makefile or scripts/build-one.sh
Source0:        %{name}-%{version}.tar.gz
BuildArch:      noarch

BuildRequires:  librsvg2-tools

# compositor and hypr ecosystem
Requires:       hyprland
Requires:       xdg-desktop-portal-hyprland
Requires:       xdg-desktop-portal-gtk
Requires:       hyprpaper
Requires:       hypridle
Requires:       hyprlock
Requires:       hyprpolkitagent
Requires:       hyprlauncher
Requires:       hyprland-guiutils
Requires:       hyprshutdown
Requires:       hyprpicker
Requires:       hyprsunset
# bar, notifications, screenshots, clipboard, media
Requires:       waybar
Requires:       mako
Requires:       libnotify
Requires:       grim
Requires:       slurp
Requires:       wl-clipboard
Requires:       jq
Requires:       playerctl
Requires:       brightnessctl
Requires:       pipewire
Requires:       wireplumber
Requires:       pipewire-pulseaudio
# terminal, toolkit integration, fonts, look
Requires:       kitty
Requires:       less
Requires:       glib2
Requires:       xdg-utils
Requires:       xdg-user-dirs
Requires:       qt6-qtwayland
Requires:       adwaita-icon-theme
Requires:       jetbrains-mono-fonts
Requires:       fontawesome-6-free-fonts
Requires:       fontawesome-6-brands-fonts
Requires:       polkit
Requires:       NetworkManager-tui

# small useful desktop applications, installed by default but removable
Recommends:     nautilus
Recommends:     firefox
Recommends:     pavucontrol
Recommends:     nm-connection-editor
Recommends:     btop

# optional, not installed by default (dnf install <name>):
# Qt theme integration, extra hypr tools, nicer icons
Suggests:       hyprqt6engine
Suggests:       hyprland-qt-support
Suggests:       hyprpwcenter
Suggests:       hyprsysteminfo
Suggests:       papirus-icon-theme
Suggests:       qt5-qtwayland

%description
Meta package and default configuration that turns the Hyprland compositor into
a complete desktop: wallpaper (hyprpaper), status bar (waybar), notifications
(mako), lock screen (hyprlock), idle handling (hypridle), polkit agent,
screen sharing portal, launcher, screenshots, clipboard, media and brightness
keys, a dark theme and a curated Hyprland configuration with blur,
animations, groups, a scratchpad and a key binding cheat sheet (SUPER+F1).

The configuration is installed system wide in /etc/xdg/hypr and is used by
every user who does not have an own ~/.config/hypr/hyprland.lua.
Run "hypr-el-setup" once if Hyprland already created an autogenerated config,
or "hypr-el-setup --copy" to get editable copies in ~/.config.

%prep
%autosetup -n %{name}

%build
rsvg-convert -w 3840 -h 2160 wallpaper/hypr-el-aurora.svg -o hypr-el-aurora.png

%install
install -Dpm 0644 hypr/hyprland.lua   %{buildroot}%{_sysconfdir}/xdg/hypr/hyprland.lua
install -Dpm 0644 hypr/hyprpaper.conf %{buildroot}%{_sysconfdir}/xdg/hypr/hyprpaper.conf
install -Dpm 0644 hypr/hypridle.conf  %{buildroot}%{_sysconfdir}/xdg/hypr/hypridle.conf
install -Dpm 0644 hypr/hyprlock.conf  %{buildroot}%{_sysconfdir}/xdg/hypr/hyprlock.conf
install -Dpm 0644 hypr/hyprtoolkit.conf %{buildroot}%{_sysconfdir}/xdg/hypr/hyprtoolkit.conf

install -Dpm 0644 waybar/config.jsonc %{buildroot}%{_datadir}/hypr-el/waybar/config.jsonc
install -Dpm 0644 waybar/style.css    %{buildroot}%{_datadir}/hypr-el/waybar/style.css
install -Dpm 0644 mako/config         %{buildroot}%{_datadir}/hypr-el/mako/config
install -Dpm 0644 kitty/kitty.conf    %{buildroot}%{_datadir}/hypr-el/kitty/kitty.conf
install -Dpm 0644 keybindings.txt     %{buildroot}%{_datadir}/hypr-el/keybindings.txt

install -Dpm 0644 hypr-el-aurora.png            %{buildroot}%{_datadir}/backgrounds/hypr-el/hypr-el-aurora.png
install -Dpm 0644 wallpaper/hypr-el-aurora.svg  %{buildroot}%{_datadir}/backgrounds/hypr-el/hypr-el-aurora.svg

install -Dpm 0755 bin/hypr-el-setup      %{buildroot}%{_bindir}/hypr-el-setup
install -Dpm 0755 bin/hypr-el-keys       %{buildroot}%{_bindir}/hypr-el-keys
install -Dpm 0755 bin/hypr-el-screenshot %{buildroot}%{_bindir}/hypr-el-screenshot

%files
%dir %{_sysconfdir}/xdg/hypr
%config(noreplace) %{_sysconfdir}/xdg/hypr/hyprland.lua
%config(noreplace) %{_sysconfdir}/xdg/hypr/hyprpaper.conf
%config(noreplace) %{_sysconfdir}/xdg/hypr/hypridle.conf
%config(noreplace) %{_sysconfdir}/xdg/hypr/hyprlock.conf
%config(noreplace) %{_sysconfdir}/xdg/hypr/hyprtoolkit.conf
%{_datadir}/hypr-el/
%{_datadir}/backgrounds/hypr-el/
%{_bindir}/hypr-el-setup
%{_bindir}/hypr-el-keys
%{_bindir}/hypr-el-screenshot

