+        htSetLayoutHeight(LAYOUT, sc<int>(maxSize.y * PANGO_SCALE * m_impl->lastScale), m_impl->data.noEllipsize);
     else
         pango_layout_set_height(LAYOUT, -1);
 
@@ -243,7 +258,7 @@
