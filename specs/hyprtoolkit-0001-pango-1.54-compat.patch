EL10 compatibility: Pango 1.54 lacks PANGO_WRAP_NONE (added in 1.56).
Emulate single-line ellipsizing via layout height -1; no change on Pango >= 1.56.

--- a/src/element/text/Text.cpp
+++ b/src/element/text/Text.cpp
@@ -20,6 +20,21 @@
 #include "../../system/DesktopMethods.hpp"
 #include "Macros.hpp"
 
+// EL10 compat: Pango < 1.56 has no PANGO_WRAP_NONE. Emulate it: while ellipsizing,
+// a layout height of -1 makes Pango keep every paragraph on a single line.
+#if !PANGO_VERSION_CHECK(1, 56, 0)
+#define HT_PANGO_NO_WRAP_NONE 1
+#endif
+static void htSetLayoutHeight(PangoLayout* layout, int height, bool noEllipsize) {
+#ifdef HT_PANGO_NO_WRAP_NONE
+    if (!noEllipsize) {
+        pango_layout_set_height(layout, -1);
+        return;
+    }
+#endif
+    pango_layout_set_height(layout, height);
+}
+
 using namespace Hyprtoolkit;
 using namespace Hyprgraphics;
 
@@ -186,7 +201,7 @@
